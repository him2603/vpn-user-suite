# ── VPN Self-Service Portal — LAN deployment configuration ──────────────
# Copy this file to ".env" and fill in your values, then start the portal.
#
# 1. VPN_AGENT_URL — the HTTPS address of your RHEL agent (nginx endpoint)
# 2. VPN_AGENT_SECRET — the SAME value you set as PORTAL_SHARED_SECRET in
#    /etc/vpn-portal-agent/agent.env on the RHEL server
# 3. SESSION_SECRET — a random 64-char hex string (openssl rand -hex 32)
# 4. VPN_AGENT_INSECURE_TLS — set to "1" if your agent uses a self-signed cert

# Agent URL (your RHEL server's nginx HTTPS endpoint)
VPN_AGENT_URL=https://172.16.0.146

# Shared secret — must match PORTAL_SHARED_SECRET on the RHEL server
VPN_AGENT_SECRET=

# Session signing key (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Set to "1" to accept self-signed certificates (LAN-only, not for internet use)
VPN_AGENT_INSECURE_TLS=1

# ── Optional ───────────────────────────────────────────────────────────
# Port the portal listens on (dev mode uses Vite's port, prod uses this)
PORT=3000
